# Copie para .env e ajuste. Nunca versione o .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Papel "app": sujeito a RLS (nao pode ser superusuario).
DB_NAME=psiq
DB_USER=psiq_app
DB_PASSWORD=psiq_dev
DB_HOST=localhost
DB_PORT=5432

# Chave mestra (Fernet) para segredos cifrados. Em producao fica fora do banco e do backup.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSIQ_CHAVE_MESTRA=

# Inatividade maxima da sessao, em segundos.
PSIQ_INATIVIDADE_SEGUNDOS=1800

# Avisos por e-mail (em desenvolvimento, saem no console)
PSIQ_URL_BASE=http://localhost:8000
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PSIQ <nao-responder@exemplo.com>

# Notificacoes push (opcional). Chaves: npx web-push generate-vapid-keys
# PSIQ_VAPID_PUBLIC_KEY=
# PSIQ_VAPID_PRIVATE_KEY=
# PSIQ_VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Calendarios externos (opcional): Google Calendar e Outlook/Microsoft 365
# PSIQ_GOOGLE_CLIENT_ID=
# PSIQ_GOOGLE_CLIENT_SECRET=
# PSIQ_MICROSOFT_CLIENT_ID=
# PSIQ_MICROSOFT_CLIENT_SECRET=
# PSIQ_MICROSOFT_TENANT=common

# Monitoramento: alertas por e-mail do operador e marcador do ultimo backup bem-sucedido
# PSIQ_ALERTA_EMAIL=operador@seudominio.com.br
# PSIQ_BACKUP_MARCADOR=/var/lib/psiq/ultimo-backup-ok

# Instalacao sob prefixo atras de um proxy (ex.: https://homolog.exemplo.com/psiq)
# PSIQ_PREFIXO=/psiq
# PSIQ_URL_BASE=https://homolog.exemplo.com/psiq
# PSIQ_ORIGENS_CONFIAVEIS=https://homolog.exemplo.com
# DJANGO_ALLOWED_HOSTS=homolog.exemplo.com,localhost,127.0.0.1
# PSIQ_HSTS_SEGUNDOS=0   # se o proxy ja envia Strict-Transport-Security
