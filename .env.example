# Copie para .env e ajuste. Nunca versione o .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Papel "app": sujeito a RLS (nao pode ser superusuario).
DB_NAME=psiq
DB_USER=psiq_app
DB_PASSWORD=psiq_dev
DB_HOST=localhost
DB_PORT=5432

# Chave mestra (Fernet) para segredos cifrados. Em producao fica fora do banco e do backup.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSIQ_CHAVE_MESTRA=

# Inatividade maxima da sessao, em segundos.
PSIQ_INATIVIDADE_SEGUNDOS=1800
